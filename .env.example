# 复制为 .env 后填写真实密钥；不要提交 .env。

# 主视觉模型
VLM_CLIENT_TYPE=openai
VLM_CLIENT_CFG_NAME=kimi-k3
VLM_CLIENT_CFG_API_BASE=https://api.moonshot.cn/v1
VLM_CLIENT_CFG_API_KEY=your-visual-model-key
VLM_CLIENT_CFG_MESSAGE_ROLE=user

# 瑞文首答视觉校验：K3 直接读取含三道题的原始整图，全程只发一次视觉请求。
# API_KEY 留空时回退到 VLM_CLIENT_CFG_API_KEY。
RAVEN_ENABLE_VLM=1
RAVEN_VLM_MODEL=kimi-k3
RAVEN_VLM_API_BASE=https://api.moonshot.cn/v1
RAVEN_VLM_TIMEOUT_SECONDS=30
RAVEN_VLM_API_KEY=
RAVEN_VLM_OVERRIDE_CONFIDENCE=0.85

# 瑞文独立文本验证器（仅服务端拒绝后的修正轮启用）
RAVEN_ENABLE_TEXT_VERIFIER=1
RAVEN_TEXT_MODEL=deepseek-v4-pro
RAVEN_TEXT_API_BASE=https://api.deepseek.com
RAVEN_TEXT_TIMEOUT_SECONDS=35
RAVEN_ENABLE_EXPERIENCE=1
# Optional override; default is logs/raven_experience.json
RAVEN_EXPERIENCE_PATH=
RAVEN_TEXT_API_KEY=your-deepseek-key

# NPC 最终决策的独立文本模型。留空则回退到主视觉模型，但推理模型会显著拖慢作答。
NPC_ENABLE_TEXT_DECIDER=1
NPC_TEXT_MODEL=deepseek-flash
NPC_TEXT_API_BASE=https://api.deepseek.com
NPC_TEXT_TIMEOUT_SECONDS=35
# 留空时依次回退到 DEEPSEEK_API_KEY
NPC_TEXT_API_KEY=your-deepseek-key

# 计数候选复核的独立视觉模型。留空则复用主视觉模型，但推理模型单次复核可能上百秒。
COUNTING_ENABLE_REVIEW_MODEL=1
COUNTING_REVIEW_MODEL=kimi-k2.7-code-highspeed
COUNTING_REVIEW_API_BASE=https://api.moonshot.cn/v1
COUNTING_REVIEW_TIMEOUT_SECONDS=90
# 留空时回退到 VLM_CLIENT_CFG_API_KEY
COUNTING_REVIEW_API_KEY=your-moonshot-key

# 整理房间专属视觉模型。912 不下发目标清单，语义只能靠模型补充，
# 而主视觉模型（推理模型）单次 70 秒以上，400 秒的题目跑不完几个。
# 整理房间使用独立的 Kimi 高速视觉客户端，不影响其他赛题的主模型。
TIDYROOM_ENABLE_VLM=1
TIDYROOM_VLM_MODEL=kimi-k2.6
TIDYROOM_VLM_API_BASE=https://api.moonshot.cn/v1
TIDYROOM_VLM_TIMEOUT_SECONDS=45
TIDYROOM_VLM_API_KEY=

# 可选厂商密钥
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
STEPAI_API_KEY=
LINGYI_API_KEY=
DEEPSEEK_API_KEY=
RAVEN_TEXT_MAX_CONCURRENCY=1
